// prisma/schema.prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
  COOK
  STAFF
  VISITOR
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PreferenceStatus {
  PENDING
  PREPARED
  DELIVERED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Resident {
  id          Int          @id @default(autoincrement())
  fullName    String
  dob         DateTime?
  age         Int?
  room        String?
  photoUrl    String?
  contact     String?
  notes       String?
  preferences Preference[]
  appointments Appointment[]
  createdAt   DateTime     @default(now())
}

model Preference {
  id         Int             @id @default(autoincrement())
  resident   Resident        @relation(fields: [residentId], references: [id])
  residentId Int
  mealDate   DateTime
  mealType   MealType
  salty      Boolean         @default(false)
  spicyLevel SpiceLevel      @default(NONE)
  sugar      Boolean         @default(false)
  notes      String?
  status     PreferenceStatus @default(PENDING)
  createdAt  DateTime        @default(now())
}

model Donation {
  id        Int            @id @default(autoincrement())
  donorName String?
  email     String?
  phone     String?
  amount    Decimal        @db.Decimal(10,2)
  status    DonationStatus @default(COMPLETED)
  message   String?
  createdAt DateTime       @default(now())
}

model Appointment {
  id          Int               @id @default(autoincrement())
  visitorName String
  visitorType String?
  resident    Resident?         @relation(fields: [residentId], references: [id])
  residentId  Int?
  purpose     String
  datetime    DateTime
  status      AppointmentStatus @default(PENDING)
  contact     String?
  notes       String?
  createdAt   DateTime          @default(now())
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  role      Role
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isPublic  Boolean  @default(true)
  publishAt DateTime?
  createdAt DateTime @default(now())
}

model FinanceEntry {
  id        Int      @id @default(autoincrement())
  type      String
  amount    Decimal  @db.Decimal(10,2)
  source    String?
  note      String?
  date      DateTime @default(now())
}


